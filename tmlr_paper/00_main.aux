\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Interference heatmaps comparing Continuous Thought (CT) and Coconut (CO).} Each panel shows $|G_{ij}|$ for the bottleneck weight matrix ($n = 768$ features). At $d = 32$ (top), both models show diffuse off-diagonal interference due to high compression ($24\times $). At $d = 256$ (bottom), interference is minimal. CO consistently shows less interference than CT at matched $d$, supporting the time-space tradeoff (Theorem~\ref {thm:timespace}).}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:interference_comparison}{{5}{14}{\textbf {Interference heatmaps comparing Continuous Thought (CT) and Coconut (CO).} Each panel shows $|G_{ij}|$ for the bottleneck weight matrix ($n = 768$ features). At $d = 32$ (top), both models show diffuse off-diagonal interference due to high compression ($24\times $). At $d = 256$ (bottom), interference is minimal. CO consistently shows less interference than CT at matched $d$, supporting the time-space tradeoff (Theorem~\ref {thm:timespace})}{figure.5}{}}
\newlabel{fig:interference_comparison@cref}{{[figure][5][]5}{[1][12][]14}{}{}{}}
